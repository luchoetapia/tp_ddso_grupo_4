FROM node:24-alpine

# Crear el directorio de la aplicación en el contenedor
WORKDIR /app

# Copiar los archivos de dependencias
COPY package*.json ./

# Instalar las dependencias
RUN npm install

# Copiar el resto del código fuente
COPY . .

# Exponer el puerto en el que corre Express (ej. 3000)
EXPOSE 3000

# Comando por defecto para iniciar la aplicación (ajusta según tu package.json)
CMD ["npm", "start"]