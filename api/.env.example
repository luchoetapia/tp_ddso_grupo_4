# Servidor
PORT=3000
# En "production" las cookies se envían solo por HTTPS
NODE_ENV=development

# Base de datos
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=nombre_de_la_db

# JWT (usar valores largos y aleatorios, distintos entre sí)
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_KEY=
JWT_REFRESH_KEY=

# Duración de los tokens (y de sus cookies): número entero + unidad s, m, h, d o w. Por defecto 15m y 7d
JWT_ACCESS_TIME=15m
JWT_REFRESH_TIME=7d

# Password de los usuarios que crean los seeds (llenarDatosPrueba). Vacío = aleatoria (no se puede loguear con ellos)
SEED_PASSWORD=

# CORS: orígenes permitidos separados por coma. Vacío = se permiten todos
CORS_ORIGINS=http://localhost:5173

# Registro / ingreso con LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://<url>/api/auth/linkedin/callback
LINKEDIN_TOKEN_KEY=
LINKEDIN_API_VERSION=202610

# Cron diario (00:00): días sin logros nuevos para marcar un proyecto en curso para revisión. Por defecto 30
DIAS_SIN_ACTUALIZACION=30

# Origen del front (sin ruta): el back le agrega /colaboradoras/inicio, /registro?origen=linkedin o /ingresar?errorLinkedin=...
FRONT_URL=http://localhost:3001
