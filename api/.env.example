# Servidor
PORT=3000
# En "production" las cookies se envían solo por HTTPS
NODE_ENV=development

# Base de datos
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=nombre_de_la_db

# JWT (usar valores largos y aleatorios, distintos entre sí)
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_KEY=
JWT_REFRESH_KEY=

JWT_ACCESS_TIME=15m
JWT_REFRESH_TIME=7d

# CORS: orígenes permitidos separados por coma. Vacío = se permiten todos
CORS_ORIGINS=http://localhost:5173
