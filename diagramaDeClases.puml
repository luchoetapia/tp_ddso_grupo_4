@startuml
skinparam nodesep 40
skinparam ranksep 50

' Nivel 1: Organización
class Colectivo {
  id : Int
  nombre : String
  descripcion : String
  ubicacion : String
  tipo: TipoColectivo
  proyectos : List
}

class Proyecto {
id : Int 
titulo : String
descripcion : String
perfiles: List<Perfil>
porcentajeFinalizado: Float
enlaceSistema : String
enlaceCodigoFuente : String
logros: List<Logros>
limiteColaboradores :Int
estrategiaAceptacion : EstrategiaAceptacion
}

class EstrategiaAceptacion {
    nombre : String

    Boolean evaluarColaborador(Colaborador)
}

class Logro {
  titulo: String
  descripcion: String
}

' Nivel 3: Perfil
class Perfil {
  descripcion : String
  habilidadesRequeridas : List
  habilidadesOpcionales : List
  tipoCompromiso : TipoCompromiso
  modalidadColaboracion : ModalidadColaboracion
  busquedaAbierta : Boolean
  limiteColaboraciones : Int
  fechaFinBusqueda : LocalDate
}

class TipoCompromiso {
  cantHoras : Int
  periodo : Periodo
}

class ModalidadColaboracion {
  incentivoEconomico : Float
  posibleContratacion : boolean
}

' Nivel 4: Flujos (Postulación y Colaboración)
class Postulacion {
  fecha : LocalDate
  estado : EstadoPostulacion
  mensaje : String
  colaborador : Colaborador
  perfil : Perfil
}

class Colaboracion {
  proyecto : Proyecto
  colaborador : Colaborador
  perfil : Perfil
  esAnonima : Boolean
  fechaInicio : LocalDate
  fechaFin : LocalDate
  activa : Boolean
}

' Nivel 5: Actor y Habilidad
class Colaborador {
  id: Int
  nombre : String
  apellido : String
  nombreFantasia : String
  cuentaGit : String
  habilidades : List
  pronombres : List
  presentacion : String
  deseaSerContactado : Boolean
  notificaciones : List
  contactos : List
}

class Habilidad {
  id : String
  titulo : String
  tipoHabilidad : TipoHabilidad
  descripcion : String
}

class Contacto {
  medio : MedioDeContacto
  valor : String
}

class Notificacion {
  proyecto: Proyecto
  mensaje: String
  fecha: LocalDate
}


enum TipoColectivo {
  FUNDACION
  ASOCIACION_BARRIAL
  ONG
  ASAMBLEA
}

enum EstadoPostulacion {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

enum Periodo {
  MENSUAL
  SEMANAL
  TOTAL
}

enum MedioDeContacto {
  EMAIL
  WHATSAPP
  SMS
}

enum TipoHabilidad {
  PROGRAMACION
  DISEÑO
  MARKETING
  COMUNICACION
  GESTION_PROYECTOS
  COLABORACION
}

together {
  class Colectivo
  enum TipoColectivo
}

together {
  class Proyecto
  class Logro
}

together {
  class Perfil
  class TipoCompromiso
  class ModalidadColaboracion
}

together {
  class Postulacion
  class Colaboracion
  enum EstadoPostulacion
}

together {
  class Colaborador
  class Habilidad
  class Contacto
  class Notificacion
}

Colectivo -r-> TipoColectivo
Colectivo --> " * " Proyecto
Proyecto --> " * " Logro
Proyecto --> " * " Perfil

Perfil --> TipoCompromiso
Perfil --> ModalidadColaboracion
Perfil --> " * " Habilidad

Postulacion --> Perfil
Postulacion --> EstadoPostulacion
Postulacion --> Colaborador

Colaboracion --> Proyecto
Colaboracion --> Perfil
Colaboracion --> Colaborador

Colaborador --> " * " Habilidad
Colaborador --> " * " Contacto
Colaborador --> " * " Notificacion

Habilidad --> TipoHabilidad
Contacto --> MedioDeContacto

TipoCompromiso -d-> Periodo

Proyecto -> EstrategiaAceptacion
@enduml
