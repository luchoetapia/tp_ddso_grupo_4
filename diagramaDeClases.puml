@startuml

class Colectivo {
id : Int
nombre : String
descripcion : String
ubicacion : String
tipo: TipoColectivo
proyectos : List<Proyecto>
}

'(Fran): Aca sacaría el finalizado y le dejearía el porcentaje solo.
class Proyecto {
id : Int 
titulo : String
descripcion : String
perfiles: List<Perfil>
finalizado: boolean
porcentajeFinalizado: Float
enlaceSistema : String
enlaceCodigoFuente : String
logros: List<Logros>
}

'(Fran): No estoy seguro que mas agregarle a los logros, consultar.
class Logro {
titulo: String
descripcion: String
}

class Perfil {
descripcion : String
habilidadesRequeridas : List<Habilidad>
habilidadesOpcionales : List<Habilidad>
tipoCompromiso : TipoCompromiso
modalidadColaboracion : ModalidadColaboracion
}

class TipoCompromiso {
cantHoras : Int
periodo : Periodo
}

' Cambio el id a String, porque el enunciado dice que es el titulo normalizado.
class Habilidad {
id : String
titulo : String
tipoHabilidad : TipoHabilidad
descripcion : String
}

class Colaborador{
id: Int
nombre : String
apellido : String
nombreFantasia : String
cuentaGit : String
habilidades : List<Habilidad>
pronombres : List<String>
presentacion : String
deseaSerContactado : Boolean
notificaciones : List<Notificacion>
contactos : List<Contacto>
}

class Contacto {
medio : MedioDeContacto
valor : String
}

enum MedioDeContacto {
EMAIL,
WHATSAPP,
SMS
}

class Notificacion {
proyecto: Proyecto
mensaje: String
fecha: LocalDate
}

class Colaboracion {
proyecto : Proyecto
colaborador : Colaborador
esAnonima : Boolean
}

class ModalidadColaboracion {
incentivoEconomico : Float
posibleContratacion : boolean
}

enum TipoColectivo {
FUNDACION, 
ASOCIACION_BARRIAL, 
ONG, 
ASAMBLEA,
}

enum Periodo {
MENSUAL, 
SEMANAL, 
TOTAL,
}

enum TipoHabilidad {
PROGRAMACION, 
DISEÑO, 
MARKETING, 
COMUNICACION, 
GESTION_PROYECTOS, 
COLABORACION,
}

Colectivo -d-> " * " Proyecto
Colectivo -l-> TipoColectivo

Proyecto -d-> " * " Perfil
Proyecto -> " * " Logro

Perfil -r-> TipoCompromiso
Perfil -l-> ModalidadColaboracion
Perfil -u-> " * " Habilidad

Colaboracion -d-> Proyecto

Colaborador <-u- Colaboracion
Colaborador -d-> " * " Habilidad
Colaborador -l-> " * " Contacto
Colaborador -> " * " Notificacion

Contacto -u-> MedioDeContacto

TipoCompromiso -r-> Periodo

Habilidad -l-> TipoHabilidad
@enduml
