@startuml

class Colectivo {
id : Int
nombre : String
descripcion : String
ubicacion : String
tipo: TipoColectivo
proyectos : List<Proyecto>
}

class Proyecto {
id : Int 
titulo : String
descripcion : String
habilidades : List<Habilidad>
tipoCompromiso : TipoCompromiso
modalidadColaboracion : ModalidadColaboracion
}

class TipoCompromiso {
cantHoras : Int
periodo : Periodo
}

class Habilidad {
titulo : String
tipoHabilidad : TipoHabilidad
id : String
descripcion : String
}

class Colaborador{
nombre : String
apellido : String
nombreFantasia : String
cuentaGit : String
habilidades : List<Habilidad>
pronombres : List<String>
presentacion : String
}

class Colaboracion {
proyecto : Proyecto
colaborador : Colaborador
}

class ModalidadColaboracion {
incentivoEconomico : Float
posibleContratacion : boolean
}

enum TipoColectivo {
FUNDACION, 
ASOCIACION_BARRIAL, 
ONG, 
ASAMBLEA,
}

enum Periodo {
MENSUAL, 
SEMANAL, 
TOTAL,
}

enum TipoHabilidad {
PROGRAMACION, 
DISEÑO, 
MARKETING, 
COMUNICACION, 
GESTION_PROYECTOS, 
COLABORACION,
}

Colectivo -d-> "*" Proyecto
Colectivo -r-> TipoColectivo

Proyecto -> "*" Habilidad
Proyecto -d-> TipoCompromiso
Proyecto -> ModalidadColaboracion

Colaboracion -> Proyecto
Colaborador <- Colaboracion
Colaborador -u-> "*" Habilidad

TipoCompromiso -r-> Periodo
Habilidad -l-> TipoHabilidad

@enduml